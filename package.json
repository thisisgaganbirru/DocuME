{
  "name": "pdf-converter-pro",
  "version": "1.0.0",
  "description": "Secure PDF Conversion Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "test": "jest --testPathPattern=tests/",
    "test:unit": "jest --testPathPattern=tests/unit/",
    "test:integration": "jest --testPathPattern=tests/integration/",
    "test:security": "jest --testPathPattern=tests/security/",
    "test:coverage": "jest --coverage --testPathPattern=tests/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "jsonwebtoken": "^9.0.2",
    "google-auth-library": "^9.6.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "sharp": "^0.33.0",
    "pdfkit": "^0.13.0",
    "uuid": "^9.0.0",
    "node-cron": "^3.0.3",
    "cookie-parser": "^1.4.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@jest/globals": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterFramework": ["./tests/setup.js"],
    "testTimeout": 15000
  }
}
